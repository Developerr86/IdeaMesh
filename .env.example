# LLM
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Web Search (Scout stage)
# Keyless provider chain: DuckDuckGo (default) -> Bing fallback.
# Tavily remains an explicit legacy override only.
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
# Fetch full page text for top results (default: true; set false to skip)
SEARCH_ENRICH_PAGES=true

# Supabase (optional for local dev — pipelines fall back to localStorage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
