# LLM
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Web Search (Scout stage)
# Provider: auto (default) | tavily | duckduckgo
# auto = Tavily when TAVILY_API_KEY is set, otherwise free DuckDuckGo search
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
# Fetch full page text for top results (default: true; set false to skip)
SEARCH_ENRICH_PAGES=true

# Supabase (optional for local dev — pipelines fall back to localStorage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
